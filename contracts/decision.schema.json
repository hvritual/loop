{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal",
    "digest",
    "decision",
    "reason"
  ],
  "properties": {
    "proposal": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "defer"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
