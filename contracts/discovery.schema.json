{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "question",
    "hypothesis",
    "falsifier",
    "criterion",
    "severity",
    "scope"
  ],
  "properties": {
    "category": {
      "enum": [
        "requirement",
        "alternative",
        "boundary",
        "assumption",
        "opportunity",
        "security"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "falsifier": {
      "type": "string",
      "minLength": 1
    },
    "criterion": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "enum": [
          "discover",
          "design",
          "build",
          "deploy"
        ]
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
