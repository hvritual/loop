{
  "schema_version": 1,
  "checks": {
    "unit": {
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "timeout_seconds": 120
    },
    "lint": {
      "argv": [
        "{python}",
        "scripts/loop.py",
        "lint"
      ],
      "timeout_seconds": 30
    },
    "demo": {
      "argv": [
        "{python}",
        "scripts/demo.py"
      ],
      "timeout_seconds": 120
    }
  }
}
